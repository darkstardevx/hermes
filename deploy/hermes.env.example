# Copy this file to /etc/hermes/hermes.env and set real values there.
# Keep this file root-owned and never commit the real environment file.
DISCORD_TOKEN=paste-your-bot-token-here
GITHUB_TOKEN=paste-your-read-only-github-token-here
DEV_LOG_CHANNEL_ID=copy-dev-log-channel-id-here
DEV_LOG_INTERVAL_SECS=3600
DEV_LOG_STATE_FILE=/var/lib/hermes/dev-log-state.json
