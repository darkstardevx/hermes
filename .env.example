DISCORD_TOKEN=paste-your-bot-token-here
GITHUB_TOKEN=optional-pat-for-higher-rate-limits

# Optional scheduled digest for #dev-log. Copy the channel ID from Discord
# with Developer Mode enabled. The first run seeds state without posting old
# activity; later polls post only new project activity or releases.
# DEV_LOG_CHANNEL_ID=copy-dev-log-channel-id-here
# DEV_LOG_INTERVAL_SECS=3600
# DEV_LOG_STATE_FILE=.hermes/dev-log-state.json
